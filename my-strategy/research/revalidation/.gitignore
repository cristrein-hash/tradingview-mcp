# Strategy Revalidation Lab — ignore bulk per-trade outputs.
# These are deterministically regenerable from config.json + canonical data +
# the code commit recorded in report.json. Everything else (methodology, config,
# report, summary, schemas) is tracked as auditable evidence.
**/trades.jsonl

# D1a generated EMA dataset (regenerable from RAW 1D via build_xau_1d_ema_features.py)
**/generated/*.jsonl

# Round-1 mechanical rebuild bulk outputs (regenerable from run_mechanical_rebuild_v1.py)
**/results/*_trades.jsonl
**/results/*_plot_ready.csv

# Entry anatomy substrate (regenerable from RAW via build_entry_anatomy.py)
**/results/entry_anatomy.jsonl

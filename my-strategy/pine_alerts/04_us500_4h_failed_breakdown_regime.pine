//@version=5
// US500_4H_LONG_FAILED_BREAKDOWN_REGIME — alert source
// Backtest: 45 trades / 7.4y / PF 1.83
// Trigger DIFERENTE: sweep low(20) + reclaim
// Created 2026-05-15.

indicator("US500 4H FAILED_BREAKDOWN_REGIME — Alert", overlay=true)

swing_len  = 20
body_min   = 0.5
ema_fast   = 50
ema_slow   = 200
atr_len    = 14
atr_ma_len = 20
stop_atr_mult = 0.5
target_r   = 2.5

atr14 = ta.atr(atr_len)
atr_ma = ta.sma(atr14, atr_ma_len)
atr_expanding = atr14 > atr_ma

ema50  = ta.ema(close, ema_fast)
ema200 = ta.ema(close, ema_slow)

swlo_20 = ta.lowest(low, swing_len)[1]
body_pct = math.abs(close - open) / math.max(high - low, syminfo.mintick)

// Trigger: failed breakdown
t_sweep_low  = low < swlo_20
t_reclaim    = close > swlo_20
t_bullish    = close > open
t_body       = body_pct >= body_min

f1_above_ema200 = close > ema200
f2_ema_stack    = ema50 > ema200
f3_atr_expand   = atr_expanding

all_triggers = t_sweep_low and t_reclaim and t_bullish and t_body
all_filters  = f1_above_ema200 and f2_ema_stack and f3_atr_expand

setup_qualified = all_triggers and all_filters and barstate.isconfirmed

entry_price = close
stop_price  = low - stop_atr_mult * atr14
r_points    = entry_price - stop_price
r_sanity_pass = r_points > 0 and r_points <= 5 * atr14

setup_final = setup_qualified and r_sanity_pass

plotshape(setup_final, title="Module Trigger", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.small, text="MOD")
bgcolor(setup_final ? color.new(color.green, 85) : na)

if setup_final
    target_price = entry_price + target_r * r_points
    sym_s   = syminfo.tickerid
    tf_s    = timeframe.period
    ep_s    = str.tostring(entry_price, "#.##")
    sp_s    = str.tostring(stop_price, "#.##")
    tg_s    = str.tostring(target_price, "#.##")
    rp_s    = str.tostring(r_points, "#.##")
    atr_s   = str.tostring(atr14, "#.##")
    body_s  = str.tostring(body_pct, "#.##")
    sw_s    = str.tostring(swlo_20, "#.##")
    px_s    = str.tostring(close, "#.##")
    ts_s    = str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

    alert_msg = "{" + "\"symbol\":\"" + sym_s + "\"," + "\"base_symbol\":\"US500\"," + "\"timeframe\":\"" + tf_s + "\"," + "\"ts_signal\":\"" + ts_s + "\"," + "\"alert_type\":\"module_trigger_us500_4h_failed_breakdown\"," + "\"event\":\"mechanical_trigger_fired\"," + "\"drawing_name\":\"PINE_AUTO_TRIGGER\"," + "\"strategy_module\":\"US500_4H_LONG_FAILED_BREAKDOWN_REGIME\"," + "\"module_backtest_n\":45," + "\"direction\":\"LONG\"," + "\"trigger_method\":\"sweep_low_20_with_reclaim\"," + "\"entry_price\":" + ep_s + "," + "\"stop_price\":" + sp_s + "," + "\"target_price_2_5r\":" + tg_s + "," + "\"r_points\":" + rp_s + "," + "\"atr14\":" + atr_s + "," + "\"body_pct\":" + body_s + "," + "\"swing_low_20\":" + sw_s + "," + "\"price\":" + px_s + "," + "\"priority\":\"A\"," + "\"reason\":\"Trigger mecanico US500 4H FAILED_BREAKDOWN (sweep+reclaim swing_low_20). Promote a SETUP_VALIDO se hard blocks PASS.\"" + "}"
    alert(alert_msg, alert.freq_once_per_bar_close)

//@version=5
// EURUSD_4H_LONG_BREAKOUT_COMBO_STRICT_DXY — alert source
// Backtest: 47 trades / 7.4y / PF 2.03 / +13.35R
// Filtros: HTF1D + HTF12H bullish + DXY bearish + body 0.6 + ADX 25 + range 1.2 ATR
// Created 2026-05-15.

indicator("EURUSD 4H BREAKOUT_COMBO_STRICT_DXY — Alert", overlay=true)

swing_len  = 10
body_min   = 0.6
adx_min    = 25.0
range_atr_min = 1.2
ema_fast   = 50
ema_slow   = 200
atr_len    = 14
atr_ma_len = 20
rsi_len    = 14
rsi_ma_len = 14
stop_atr_mult = 0.5
target_r   = 2.5

atr14 = ta.atr(atr_len)
atr_ma = ta.sma(atr14, atr_ma_len)
atr_expanding = atr14 > atr_ma

ema50  = ta.ema(close, ema_fast)
ema200 = ta.ema(close, ema_slow)

swhi_10 = ta.highest(high, swing_len)[1]
body_pct = math.abs(close - open) / math.max(high - low, syminfo.mintick)
range_to_atr = (high - low) / atr14

rsi14 = ta.rsi(close, rsi_len)
rsi_ma = ta.ema(rsi14, rsi_ma_len)

[diplus, diminus, adx14] = ta.dmi(atr_len, atr_len)

// HTF1D bullish + HTF12H bullish
htf1d_close = request.security(syminfo.tickerid, "1D", close)
htf1d_ema50 = request.security(syminfo.tickerid, "1D", ta.ema(close, 50))
htf1d_bullish = htf1d_close > htf1d_ema50

htf12h_close = request.security(syminfo.tickerid, "720", close)
htf12h_ema50 = request.security(syminfo.tickerid, "720", ta.ema(close, 50))
htf12h_bullish = htf12h_close > htf12h_ema50

// DXY bearish (close < EMA50 4H)
dxy_close = request.security("TVC:DXY", "240", close)
dxy_ema50 = request.security("TVC:DXY", "240", ta.ema(close, 50))
dxy_bearish = dxy_close < dxy_ema50

t4_breakout = close > swhi_10
t5_bullish  = close > open
t6_body     = body_pct >= body_min
t7_range    = range_to_atr >= range_atr_min
t8_rsi      = rsi14 > rsi_ma

f1_above_ema200 = close > ema200
f2_ema_stack    = ema50 > ema200
f3_atr_expand   = atr_expanding
f4_adx          = adx14 >= adx_min
f5_htf1d        = htf1d_bullish
f6_htf12h       = htf12h_bullish
f7_dxy_bearish  = dxy_bearish

all_triggers = t4_breakout and t5_bullish and t6_body and t7_range and t8_rsi
all_filters  = f1_above_ema200 and f2_ema_stack and f3_atr_expand and f4_adx and f5_htf1d and f6_htf12h and f7_dxy_bearish

setup_qualified = all_triggers and all_filters and barstate.isconfirmed

entry_price = close
stop_price  = low - stop_atr_mult * atr14
r_points    = entry_price - stop_price
r_sanity_pass = r_points > 0 and r_points <= 5 * atr14

setup_final = setup_qualified and r_sanity_pass

plotshape(setup_final, title="Module Trigger", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.small, text="MOD")
bgcolor(setup_final ? color.new(color.green, 85) : na)

if setup_final
    target_price = entry_price + target_r * r_points
    sym_s   = syminfo.tickerid
    tf_s    = timeframe.period
    ep_s    = str.tostring(entry_price, "#.#####")
    sp_s    = str.tostring(stop_price, "#.#####")
    tg_s    = str.tostring(target_price, "#.#####")
    rp_s    = str.tostring(r_points, "#.#####")
    atr_s   = str.tostring(atr14, "#.#####")
    rsi_s   = str.tostring(rsi14, "#.##")
    adx_s   = str.tostring(adx14, "#.##")
    body_s  = str.tostring(body_pct, "#.##")
    sw_s    = str.tostring(swhi_10, "#.#####")
    px_s    = str.tostring(close, "#.#####")
    ts_s    = str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

    alert_msg = "{" + "\"symbol\":\"" + sym_s + "\"," + "\"base_symbol\":\"EURUSD\"," + "\"timeframe\":\"" + tf_s + "\"," + "\"ts_signal\":\"" + ts_s + "\"," + "\"alert_type\":\"module_trigger_eurusd_4h_breakout_combo_strict_dxy\"," + "\"event\":\"mechanical_trigger_fired\"," + "\"drawing_name\":\"PINE_AUTO_TRIGGER\"," + "\"strategy_module\":\"EURUSD_4H_LONG_BREAKOUT_COMBO_STRICT_DXY\"," + "\"module_backtest_n\":47," + "\"direction\":\"LONG\"," + "\"trigger_method\":\"breakout_combo_strict_with_htf_dxy_filters\"," + "\"entry_price\":" + ep_s + "," + "\"stop_price\":" + sp_s + "," + "\"target_price_2_5r\":" + tg_s + "," + "\"r_points\":" + rp_s + "," + "\"atr14\":" + atr_s + "," + "\"rsi14\":" + rsi_s + "," + "\"adx14\":" + adx_s + "," + "\"body_pct\":" + body_s + "," + "\"swing_high_10\":" + sw_s + "," + "\"price\":" + px_s + "," + "\"priority\":\"A\"," + "\"reason\":\"Trigger mecanico EUR 4H COMBO_STRICT_DXY (HTF1D+12H bull + DXY bear + body 0.6 + ADX 25 + range 1.2 ATR). Promote a SETUP_VALIDO se hard blocks PASS.\"" + "}"
    alert(alert_msg, alert.freq_once_per_bar_close)
